{
  "name": "fpvbench",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "A local workbench for FPV setup history and flight-session records.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint src public tests dev eslint.config.mjs jest.config.mjs",
    "check": "npm run lint && npm test",
    "test:browser": "node tests/browser/run.mjs",
    "restore": "node src/restore.mjs",
    "service:install": "node src/macos-service.mjs install",
    "service:start": "node src/macos-service.mjs start",
    "service:stop": "node src/macos-service.mjs stop",
    "service:restart": "node src/macos-service.mjs restart",
    "service:status": "node src/macos-service.mjs status",
    "service:open": "node src/macos-service.mjs open",
    "service:uninstall": "node src/macos-service.mjs uninstall"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  },
  "dependencies": {
    "dji-log-parser-js": "0.5.7"
  }
}
